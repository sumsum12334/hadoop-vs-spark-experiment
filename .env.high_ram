# High-RAM profile for Mac 48GB host — use most of host RAM (contrast vs Windows 16g)
# Docker Desktop VM ~44GB; container MEM_LIMIT=40g (do not set container == full host 48g).
COMPOSE_PROJECT_NAME=hscompare
RAM_PROFILE=high_ram
MEM_LIMIT=40g
CPU_LIMIT=4.0
HADOOP_HEAPSIZE=2048
YARN_NODEMANAGER_MEMORY_MB=36864
YARN_SCHEDULER_MAX_MB=36864
SPARK_WORKER_MEMORY=36g
SPARK_DRIVER_MEMORY=24g
SPARK_EXECUTOR_MEMORY=24g
YARN_AM_MEMORY_MB=1024
YARN_AM_XMX=768m
