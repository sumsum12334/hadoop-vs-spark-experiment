# High-RAM profile (~8GB) — fair cap applied to BOTH engines' containers
COMPOSE_PROJECT_NAME=hscompare
RAM_PROFILE=high_ram
MEM_LIMIT=8g
CPU_LIMIT=4.0
HADOOP_HEAPSIZE=1024
YARN_NODEMANAGER_MEMORY_MB=6144
YARN_SCHEDULER_MAX_MB=6144
SPARK_WORKER_MEMORY=6g
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=4g
